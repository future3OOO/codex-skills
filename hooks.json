{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/skill-discipline-rearm.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Agent|spawn_agent|followup_task|send_input|send_message|resume_agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/rcf-intake-gate.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/code-quality-gate.py",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
