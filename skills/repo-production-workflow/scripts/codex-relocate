#!/usr/bin/env python3
"""Relocate the calling agent's session root to a new working directory.

Usage: codex-relocate <abs-path> [thread-id] [note] [--estate <prepared-dir>]

Remote-hosted sessions (app-server socket): turn/start requests a new root.
Acceptance is pending until a subsequent native turn confirms its cwd and
hook repository; a socket acknowledgement does not establish relocation.

Native sessions use the owned launcher's resume loop even when a shared
daemon socket exists. The codex/codexs wrappers launch without that daemon
and export CODEX_RELOC_LOOP plus CODEX_RELOC_SHELL_PID. This persists trust in
~/.codex/config.toml, writes ~/.codex/reloc/<shell-pid>, and terminates
the host TUI ~10s later. The wrapper resumes the same thread at
<abs-path> in the SAME pane. Run this as the LAST action of a turn —
the kill ends the session.

thread-id defaults to $CODEX_THREAD_ID, else 'self' (the loaded thread
whose cwd matches the current directory). Socket auto-discovers
~/.codex/app-server-*.sock and ~/.codex/app-server-control/*.sock;
override with CODEX_APP_SERVER_SOCK.

--estate binds a prepared private estate at ~/.codex on native resume. It needs
an updated launcher and transfers this thread's rollout, referenced history
prefixes and scoped native UI rows. Existing target copies are refused.
"""
import socket, base64, hashlib, os, struct, json, sys, time, glob, signal, shlex, subprocess, tomllib, sqlite3, tempfile
from pathlib import Path
from contextlib import ExitStack

class WS:
    def __init__(self, path):
        self.s = socket.socket(socket.AF_UNIX); self.s.settimeout(3); self.s.connect(path)
        key = base64.b64encode(os.urandom(16)).decode()
        self.s.sendall((f"GET / HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\n"
                        f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
                        f"Sec-WebSocket-Version: 13\r\n\r\n").encode())
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = self.s.recv(4096)
            if not chunk: raise RuntimeError("ws handshake EOF")
            buf += chunk
        if b"101" not in buf.split(b"\r\n")[0]: raise RuntimeError("ws handshake failed")
        expect = base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest())
        if expect not in buf: raise RuntimeError("ws accept mismatch")
        self.buf = buf.split(b"\r\n\r\n", 1)[1]
        self.s.settimeout(0.5)
        self.frag = bytearray()
    def close(self):
        self.s.close()
    def send(self, payload):
        data = payload.encode(); mask = os.urandom(4); n = len(data)
        if n < 126: hdr = struct.pack("!BB", 0x81, 0x80 | n)
        elif n < 65536: hdr = struct.pack("!BBH", 0x81, 0x80 | 126, n)
        else: hdr = struct.pack("!BBQ", 0x81, 0x80 | 127, n)
        self.s.sendall(hdr + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))
    def _fill(self):
        try:
            while True:
                c = self.s.recv(65536)
                if not c: raise ConnectionError("closed")
                self.buf += c
                if self._ready(): return
        except socket.timeout: pass
    def _ready(self):
        if len(self.buf) < 2: return False
        n = self.buf[1] & 0x7F; off = 2
        if n == 126:
            if len(self.buf) < 4: return False
            n = struct.unpack("!H", self.buf[2:4])[0]; off = 4
        elif n == 127:
            if len(self.buf) < 10: return False
            n = struct.unpack("!Q", self.buf[2:10])[0]; off = 10
        return len(self.buf) >= off + n
    def recv(self, wait=10):
        t = time.time() + wait
        while time.time() < t:
            if self._ready():
                b0 = self.buf[0]; b1 = self.buf[1]; n = b1 & 0x7F; off = 2
                if n == 126: n = struct.unpack("!H", self.buf[2:4])[0]; off = 4
                elif n == 127: n = struct.unpack("!Q", self.buf[2:10])[0]; off = 10
                op = b0 & 0x0F
                payload = self.buf[off:off+n]; self.buf = self.buf[off+n:]
                if op == 9:
                    mask = os.urandom(4)
                    self.s.sendall(struct.pack("!BB", 0x8A, 0x80 | len(payload)) + mask
                                   + bytes(b ^ mask[i % 4] for i, b in enumerate(payload)))
                    continue
                if op == 8: raise ConnectionError("closed")
                if op in (0, 1):
                    self.frag += payload
                    if b0 & 0x80:
                        msg, self.frag = bytes(self.frag), bytearray()
                        return msg.decode()
                continue
            self._fill()
        return None

def rpc(ws, method, params, rid, wait=15):
    ws.send(json.dumps({"jsonrpc": "2.0", "id": rid, "method": method, "params": params}))
    t = time.time() + wait
    while time.time() < t:
        m = ws.recv(wait=2)
        if m is None: continue
        try: msg = json.loads(m)
        except ValueError: raise ConnectionError("malformed frame payload")
        if msg.get("id") == rid: return msg
    raise TimeoutError(f"timeout: {method}")

def sockets():
    env = os.environ.get("CODEX_APP_SERVER_SOCK")
    if env: return [env]
    return sorted(set(glob.glob(os.path.expanduser("~/.codex/*.sock"))
                    + glob.glob(os.path.expanduser("~/.codex/app-server-control/*.sock"))))

def init_ws(path):
    ws = WS(path)
    r = rpc(ws, "initialize", {"clientInfo": {"name": "codex-relocate", "version": "0"}}, 1)
    if "error" in r: raise RuntimeError(f"init failed on {path}: {r['error']}")
    ws.send(json.dumps({"jsonrpc": "2.0", "method": "initialized", "params": {}}))
    return ws

def find_thread(ws, tid, mycwd):
    """tid explicit -> verify loaded; 'self' -> match loaded thread by cwd."""
    r = rpc(ws, "thread/loaded/list", {}, 2)
    loaded = r.get("result", {}).get("data", [])
    if tid != "self":
        return tid if tid in loaded else None
    hits = []
    for i, t in enumerate(loaded):
        rr = rpc(ws, "thread/read", {"threadId": t}, 10 + i)
        th = rr.get("result", {}).get("thread", {})
        envs = th.get("environments") or []
        cwds = [e.get("cwd") for e in envs] or [th.get("cwd")]
        if any(c and os.path.realpath(c) == os.path.realpath(mycwd) for c in cwds):
            hits.append(t)
    return hits[0] if len(hits) == 1 else None

def main():
    argv = sys.argv[1:]
    if argv and argv[0] == "--resume-estate":
        source, estate, cwd, tid, note, *launch = argv[1:]
        return _estate(cwd, tid, note, estate, launch, source)
    estate = None
    if len(argv) >= 3 and argv[-2] == "--estate":
        estate, argv = argv[-1], argv[:-2]
        if not estate:
            sys.exit("estate path must be absolute and contain no whitespace")
    if not argv:
        sys.exit(__doc__.strip().split("\n")[2])
    cwd = argv[0]
    tid = argv[1] if len(argv) > 1 else os.environ.get("CODEX_THREAD_ID", "self")
    note = argv[2] if len(argv) > 2 else f"continue from {cwd}"
    if not os.path.isabs(cwd):
        sys.exit(f"worktree path must be absolute: {cwd}")
    if not os.path.isdir(cwd):
        sys.exit(f"not a directory: {cwd}")
    if any(c.isspace() for c in cwd):
        sys.exit(f"worktree path must not contain whitespace: {cwd}")
    if tid != "self" and any(c.isspace() for c in tid):
        sys.exit(f"thread id must not contain whitespace: {tid}")
    if estate and (os.environ.get("CODEX_RELOC_ESTATE") != "1"
                   or os.environ.get("CODEX_APP_SERVER_SOCK")):
        sys.exit("--estate requires an updated native launcher; reload codex-reloc-loop.bashrc before launching Codex")
    mycwd = os.getcwd()
    if (os.environ.get("CODEX_RELOC_LOOP") == "1"
            and os.environ.get("CODEX_RELOC_SHELL_PID")
            and not os.environ.get("CODEX_APP_SERVER_SOCK")):
        return self_hosted(cwd, tid, note, "pane session: using its own resume loop", estate)
    if estate:
        sys.exit("--estate requires an owned native launcher")
    last_err = "no app-server socket found — session is not remote-hosted"
    for path in sockets():
        ws = None
        try:
            ws = init_ws(path)
            found = find_thread(ws, tid, mycwd)
            if not found: last_err = f"{path}: thread {tid} not loaded"; continue
            try:
                r = rpc(ws, "turn/start", {"threadId": found, "cwd": cwd,
                                           "input": [{"type": "text", "text": note}]}, 99)
            except Exception as e:
                sys.exit(f"turn/start outcome unconfirmed on {path} ({e}); verify the thread state")
            if "error" in r: sys.exit(f"turn/start rejected on {path}: {r['error']}")
            print(f"relocation requested: thread {found} -> {cwd} (via {path}); "
                  "pending until the next native turn confirms its cwd and hook repository")
            return
        except Exception as e:
            last_err = f"{path}: {e}"; continue
        finally:
            if ws is not None:
                ws.close()
    self_hosted(cwd, tid, note, last_err)

def _trust_dir(cwd, config=None):
    """Persist trust for the relocate target in ~/.codex/config.toml so the
    resume-loop's `codex resume -C <dir>` skips the interactive trust prompt.
    Writes only a tomllib-validated candidate that proves the target's
    trust_level="trusted", and never appends a duplicate [projects."<cwd>"]
    table — a duplicate header invalidates the TOML for every launch."""
    if '"' in cwd or "\\" in cwd:
        print(f"warning: cannot persist trust for unquotable path: {cwd}", flush=True)
        return
    cfg = config or os.path.expanduser("~/.codex/config.toml")
    header = f'[projects."{cwd}"]'
    try:
        try:
            # Explicit UTF-8: the TOML grammar is Unicode and the user's
            # locale encoding is not guaranteed to be.
            with open(cfg, encoding="utf-8") as f:
                text = f.read()
        except FileNotFoundError:
            text = ""
        except (OSError, UnicodeDecodeError) as e:
            # An unreadable existing file is not an empty file — writing the
            # composed candidate would silently wipe its contents.
            print(f"warning: cannot read {cfg} ({e}); not modifying", flush=True)
            return
        try:
            parsed = tomllib.loads(text) if text.strip() else {}
        except tomllib.TOMLDecodeError:
            print(f"warning: {cfg} does not parse; not modifying", flush=True)
            return
        # Non-table shapes are legal TOML: never .get() before isinstance.
        projects = parsed.get("projects")
        entry = projects.get(cwd) if isinstance(projects, dict) else None
        # The parsed value, not a substring, decides whether anything is
        # needed — every valid TOML spelling of the same table counts.
        if isinstance(entry, dict) and entry.get("trust_level") == "trusted":
            return
        lines = text.splitlines(keepends=True)
        if isinstance(entry, dict):
            # Only the canonical spelling can be surgically corrected; a
            # differently-spelled existing table must be edited by hand —
            # appending here would write a duplicate table.
            for i, line in enumerate(lines):
                if line.strip() != header:
                    continue
                j = i + 1
                while j < len(lines) and not lines[j].lstrip().startswith("["):
                    if lines[j].split("=")[0].strip() == "trust_level":
                        lines[j] = 'trust_level = "trusted"\n'
                        break
                    j += 1
                else:
                    if j and not lines[j - 1].endswith("\n"):
                        lines[j - 1] += "\n"
                    lines.insert(j, 'trust_level = "trusted"\n')
                break
            else:
                print(f"warning: projects entry for {cwd} exists under a "
                      f"non-canonical spelling; set trust_level manually "
                      f"(not modifying {cfg})", flush=True)
                return
        elif projects is None or isinstance(projects, dict):
            if lines and not lines[-1].endswith("\n"):
                lines[-1] += "\n"
            lines.extend([f"{header}\n", 'trust_level = "trusted"\n'])
        else:
            # [[projects]], projects = [...], scalar entry: not a simple
            # mapping — leave it alone rather than guess where trust belongs.
            print(f"warning: projects table in {cfg} is not a simple mapping; "
                  f"not modifying", flush=True)
            return
        candidate = "".join(lines)
        try:
            cand = tomllib.loads(candidate).get("projects")
            if not (isinstance(cand, dict) and isinstance(cand.get(cwd), dict)
                    and cand[cwd].get("trust_level") == "trusted"):
                raise ValueError("trust_level not trusted in composed config")
        except (tomllib.TOMLDecodeError, ValueError) as e:
            print(f"warning: refusing unvalidated trust write for {cwd}: {e}", flush=True)
            return
        with open(cfg, "w", encoding="utf-8") as f:
            f.write(candidate)
    except Exception as e:
        # Outer backstop: trust persistence is best-effort — residual
        # failures degrade to warn + continue rather than abort relocation.
        print(f"warning: could not persist trust for {cwd}: {e}", flush=True)

def _history(origin: Path, target: Path, ranges: list[tuple[str, int, int | None]],
             selected: str, publish: bool, transactions: ExitStack) -> None:
    """Copy native UI-history rows for the same ranges as the model rollouts."""
    for path in origin.glob("thread_history_*.sqlite"):
        uri = path.as_uri() + "?mode=ro"
        destination = target / path.name
        if not destination.resolve().is_relative_to(target):
            sys.exit(f"history destination escapes estate: {destination}")
        if not publish and not destination.exists():
            with tempfile.TemporaryFile(dir=target):
                continue
        database = transactions.enter_context(sqlite3.connect(
            destination.as_uri() + ("?mode=rwc" if publish else "?mode=rw"), uri=True))
        database.execute("BEGIN IMMEDIATE")
        if not publish:
            database.execute("PRAGMA user_version=0")
            database.rollback()
        database.execute("ATTACH DATABASE ? AS original", (uri,))
        definitions = database.execute("SELECT type,name,sql FROM original.sqlite_master WHERE type IN ('table','index') "
                                       "AND sql IS NOT NULL AND name NOT LIKE 'sqlite_%' ORDER BY type DESC").fetchall()
        existing = {row[0] for row in database.execute("SELECT name FROM sqlite_master")}
        if publish:
            for _, name, sql in definitions:
                if name not in existing:
                    database.execute(sql)
            if "_sqlx_migrations" not in existing:
                database.execute("INSERT INTO _sqlx_migrations SELECT * FROM original._sqlx_migrations")
        for current, length, ordinal in ranges:
            for kind, name, _ in definitions:
                if kind != "table" or name == "_sqlx_migrations" or (not publish and name not in existing):
                    continue
                table = '"' + name.replace('"', '""') + '"'
                projection = name == "thread_history_projection_state"
                bounds = " AND rollout_ordinal < ?" if ordinal is not None and not projection else ""
                arguments = target_arguments = (current, ordinal) if bounds else (current,)
                query = f"SELECT * FROM original.{table} WHERE thread_id = ?{bounds}"
                if projection and ordinal is not None:
                    query = (f"SELECT thread_id,min(next_rollout_byte_offset,?),min(next_rollout_ordinal,?) "
                             f"FROM original.{table} WHERE thread_id = ?")
                    arguments = (length, ordinal, current)
                target_query = f"SELECT * FROM {table} WHERE thread_id = ?{bounds}"
                if name in existing:
                    if current == selected:
                        if database.execute(f"SELECT 1 FROM {table} WHERE thread_id = ? LIMIT 1", (current,)).fetchone():
                            sys.exit(f"target history already contains thread {current}; refusing overwrite")
                    elif not projection and database.execute(
                            f"SELECT 1 FROM ({target_query} EXCEPT {query}) LIMIT 1",
                            (*target_arguments, *arguments)).fetchone():
                        sys.exit(f"conflicting target UI history: {current}; refusing overwrite")
                if publish:
                    if projection:
                        database.execute(f"INSERT INTO {table} {query} ON CONFLICT(thread_id) DO UPDATE SET "
                                         f"next_rollout_byte_offset=max(next_rollout_byte_offset,excluded.next_rollout_byte_offset), "
                                         f"next_rollout_ordinal=max(next_rollout_ordinal,excluded.next_rollout_ordinal)", arguments)
                    else:
                        database.execute(f"INSERT INTO {table} {query} EXCEPT {target_query}",
                                         (*arguments, *target_arguments))

def _estate(cwd: str, tid: str, note: str, estate: str,
            launch: list[str] | None = None, source: str | None = None) -> str:
    target = Path(estate)
    if not target.is_absolute() or any(c.isspace() for c in estate):
        sys.exit("estate path must be absolute and contain no whitespace")
    target = target.resolve()
    if any(c.isspace() for c in str(target)):
        sys.exit("resolved estate path must contain no whitespace")
    home = Path.home() / ".codex"
    controller = Path(os.environ.get("CODEX_ESTATE_PATH", home)).resolve()
    origin = Path(source).resolve() if source else controller
    if not (target / "config.toml").is_file():
        sys.exit(f"prepared estate needs config.toml: {target}")
    if not (target / "skills/repo-production-workflow/scripts/codex-relocate").is_file():
        sys.exit(f"prepared estate needs its installed codex-relocate: {target}")
    protected = {origin, controller, *(Path(path) for path in os.environ.get("CODEX_RELOC_READONLY", "").splitlines())}
    if any(target != root and (target.is_relative_to(root) or root.is_relative_to(target)) for root in protected):
        sys.exit("source and target estates must not overlap")
    same = os.path.samefile(target, origin)
    if same and launch is None:
        return ""
    transfers = []
    ranges = []
    if not same:
        indices = []
        for root in (origin, target):
            index = {}
            for pattern in ("sessions/*/*/*/rollout-*.jsonl", "archived_sessions/rollout-*.jsonl"):
                for path in root.glob(pattern):
                    index.setdefault(path.stem[-36:], []).append(path)
            indices.append(index)
        source_index, target_index = indices
        current, limit, ordinal, visited = tid, None, None, set()
        while current:
            matches = source_index.get(current, [])
            if len(matches) != 1 or current in visited:
                sys.exit(f"missing, ambiguous or cyclic source history: {current}")
            visited.add(current)
            path = matches[0]
            size = path.stat().st_size
            length = size if limit is None else limit
            if type(length) is not int or not 0 <= length <= size:
                sys.exit(f"invalid source history boundary: {current}")
            ranges.append((current, length, ordinal))
            existing = target_index.get(current, [])
            if existing:
                if current == tid or len(existing) != 1:
                    sys.exit(f"target estate already contains thread {current}; refusing overwrite")
                with path.open("rb") as left, existing[0].open("rb") as right:
                    remaining = length
                    while remaining:
                        chunk = left.read(min(remaining, 1024 * 1024))
                        if not chunk or chunk != right.read(len(chunk)):
                            sys.exit(f"conflicting target history: {current}; refusing overwrite")
                        remaining -= len(chunk)
            else:
                destination = target / path.relative_to(origin)
                if not destination.resolve().is_relative_to(target):
                    sys.exit(f"rollout destination escapes estate: {destination}")
                parent = next(parent for parent in destination.parents if parent.exists() or parent.is_symlink())
                with tempfile.TemporaryFile(dir=parent):
                    transfers.append((path, length))
            with path.open(encoding="utf-8") as header:
                base = json.loads(header.readline())["payload"].get("history_base") or {}
            current, limit, ordinal = base.get("thread_id"), base.get("end_byte_offset"), base.get("end_ordinal_exclusive")
            if base and (not isinstance(current, str) or not current or type(ordinal) is not int or ordinal < 0):
                sys.exit("invalid source history lineage")
        with ExitStack() as cleanup:
            with ExitStack() as transactions:
                _history(origin, target, ranges, tid, launch is not None, transactions)
                if launch is not None:
                    for path, length in reversed(transfers):
                        destination = target / path.relative_to(origin)
                        destination.parent.mkdir(parents=True, exist_ok=True)
                        with path.open("rb") as reader, destination.open("xb") as writer:
                            cleanup.callback(destination.unlink)
                            remaining = length
                            while remaining:
                                sent = os.sendfile(writer.fileno(), reader.fileno(), None, remaining)
                                if not sent:
                                    sys.exit(f"source history truncated during transfer: {path}")
                                remaining -= sent
            cleanup.pop_all()
    control = home / "reloc"
    control.mkdir(exist_ok=True)
    descriptor = os.open(control, os.O_PATH)
    binding = ["bwrap", "--dev-bind", "/", "/", "--die-with-parent"]
    for departure in protected - {target}:
        binding += ["--ro-bind", str(departure), str(departure)]
    binding += ["--bind", str(target), str(home), "--bind-fd", str(descriptor), str(home / "reloc"),
                "--setenv", "CODEX_HOME", str(home), "--setenv", "CODEX_ESTATE_PATH", str(target),
                "--unsetenv", "CODEX_ESTATE_SOURCE_SHA", "--unsetenv", "CODEX_WORKFLOW_STATE_ROOT",
                "--chdir", cwd, "--"]
    try:
        if launch is None:
            subprocess.run([*binding, "codex", "app-server", "--print-startup-config"],
                           pass_fds=(descriptor,), stdout=subprocess.DEVNULL, check=True)
            return str(target)
        os.environ.update(CODEX_RELOC_LOOP="1", CODEX_RELOC_ESTATE="1",
                          CODEX_RELOC_SHELL_PID=str(os.getppid()))
        os.set_inheritable(descriptor, True)
        daemon = [] if "--no-daemon" in launch else ["--no-daemon"]
        command = ["codex", *daemon, *launch, "resume", "-C", cwd, tid]
        os.execvp("bwrap", [*binding, *command, *(["--", note] if note else [])])
    finally:
        os.close(descriptor)

def self_hosted(cwd, tid, note, why, estate=None):
    """Fallback for self-hosted TUI sessions: arm the resume loop in the
    launching shell and kill this host so the pane resumes the thread at
    the new root."""
    if tid == "self":
        tid = os.environ.get("CODEX_THREAD_ID", "")
    if tid != os.environ.get("CODEX_THREAD_ID", ""):
        sys.exit("the native resume loop can relocate only its calling thread")
    if any(c.isspace() for c in tid):
        sys.exit(f"thread id must not contain whitespace: {tid}")
    hint = f"codex resume -C {shlex.quote(cwd)} {shlex.quote(tid)}"
    if os.environ.get("CODEX_RELOC_LOOP") != "1":
        sys.exit(f"no native resume loop ({why}); from your terminal run: {hint}")
    host = shell = None
    launcher = os.environ.get("CODEX_RELOC_SHELL_PID")
    p = str(os.getppid())
    child = None
    while p and p != "1":
        try:
            comm = open(f"/proc/{p}/comm").read().strip()
        except OSError:
            break
        if comm == "codex":
            host = int(p)
        if p == launcher and comm in ("bash", "zsh", "fish", "sh"):
            shell, host = int(p), host or child
            break
        child = int(p)
        try:
            p = open(f"/proc/{p}/stat").read().rsplit(")", 1)[1].split()[1]
        except (OSError, IndexError):
            break
    if not host or not shell:
        sys.exit(f"no owned native launcher in this process ancestry ({why}); "
                 f"resume from your terminal: {hint}")
    if not tid:
        sys.exit("no thread id (pass it or export CODEX_THREAD_ID)")
    if estate:
        estate = _estate(cwd, tid, str(note).strip(), estate)
    config = str(Path(estate) / "config.toml") if estate else None
    _trust_dir(cwd, config)
    real = os.path.realpath(cwd)
    if real != cwd:
        _trust_dir(real, config)
    d = os.path.expanduser("~/.codex/reloc")
    os.makedirs(d, exist_ok=True)
    # UTF-8 + surrogateescape: under a non-UTF-8 locale argv decodes to
    # surrogates; the note must write back byte-identical, never crash.
    with open(os.path.join(d, str(shell)), "w", encoding="utf-8",
              errors="surrogateescape") as f:
        # Directory-only requests retain the legacy three fields. The estate
        # field requires the capability exported by the updated launcher.
        f.write(f"{cwd} {tid} {int(time.time())}{' ' + estate if estate else ''}\n{str(note).strip()}\n")
    print(f"relocation armed: host TUI pid {host} will be terminated after "
          f"this turn closes; shell pid {shell} will resume thread {tid} "
          f"at {cwd}", flush=True)
    # Defer the kill so this tool call returns and the turn closes cleanly —
    # an instant SIGTERM records the turn as interrupted and the resumed
    # pane opens on a spurious "Conversation interrupted" banner.
    try:
        subprocess.Popen(["bash", "-c", f"sleep 10; kill -TERM {host}"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        os.kill(host, signal.SIGTERM)

if __name__ == "__main__":
    main()
